# Copy to .env and fill in. Never commit .env.

# Postgres connection string.
#   Local dev:   postgresql://postgres:postgres@127.0.0.1:5432/mariposa
#   Production:  Supabase "Transaction pooler" connection string (port 6543) —
#                required on Netlify serverless to avoid connection exhaustion.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/mariposa

# Migration-only Postgres connection. For Supabase use the direct connection,
# or the session pooler on port 5432 when direct IPv6 connectivity is unavailable.
# Never use the transaction-pooler URL for Payload migrations.
MIGRATION_DATABASE_URL=

# Payload auth secret — long random string, unique per environment.
# Generate: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=

# Canonical site URL (no trailing slash). Local: http://localhost:3000
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Cloudflare R2 production media. Leave every R2 variable empty for local-disk
# development, or set all five together. Never expose the access keys to the client.
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Private S3 API endpoint used for uploads (origin only; no bucket/path).
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# Public delivery origin or custom-domain base path; never use R2_ENDPOINT here.
# This base URL is derived at read time and is never canonical media data in Postgres.
R2_PUBLIC_URL=https://media.example.com

# Google Maps Embed API browser-visible key. Create a dedicated key restricted
# to the Maps Embed API and the production/staging website referrers. Although
# read only on the server, it necessarily appears in the iframe URL sent to visitors.
GOOGLE_MAPS_EMBED_API_KEY=
